ENVIRONMENT=development
SECRET_KEY=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=adglobal
MYSQL_USER=adglobal
MYSQL_PASSWORD=cambiar-esta-clave

# Cadena completa alternativa (tiene prioridad si se define).
# DATABASE_URL_OVERRIDE="mysql+pymysql://usuario:clave@127.0.0.1:3306/adglobal?charset=utf8mb4"

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
UPLOAD_DIRECTORY=backend/uploads
PUBLIC_UPLOAD_URL=/uploads
MAX_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=100

# Límite de intentos de login. Con varios workers, el umbral efectivo se multiplica.
LOGIN_ACCOUNT_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_ATTEMPT_WINDOW_SECONDS=300
# Actívalo solo si el backend está detrás de un proxy que sobrescribe X-Forwarded-For.
TRUST_FORWARDED_FOR=false

# Solo son necesarias durante el primer seed. Después pueden eliminarse.
INITIAL_SAMUEL_PASSWORD=
INITIAL_JOAQUIN_PASSWORD=
