# ============================================================
# Variables de entorno - Web Pública AD GLOBAL
# Copia este archivo como `.env` y ajusta los valores.
# Las variables DEBEN empezar con VITE_ para estar disponibles
# en el navegador (Vite solo expone ese prefijo).
# ============================================================

# URL pública final del sitio (SEO / canonical)
VITE_SITE_URL="https://adglobalperu.com"

# URL del panel administrativo
VITE_ADMIN_URL="https://adglobalperu.com/panel_admin/"

# Número de WhatsApp de atención (solo dígitos, con código de país)
VITE_WHATSAPP_NUMBER="51908838291"

# Teléfono mostrado en pantalla
VITE_CONTACT_PHONE_DISPLAY="+51 908 838 291"

# Correo de atención al cliente
VITE_CONTACT_EMAIL="atencionalcliente@adglobalperu.com"

# URL base del backend Python. Necesaria para cargar imágenes y videos
# administrados desde el panel.
VITE_API_URL="http://localhost:8000/api/v1"
