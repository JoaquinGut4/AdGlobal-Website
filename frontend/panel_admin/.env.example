# ============================================================
# Variables de entorno - Panel Administrativo AD GLOBAL
# Copia este archivo como `.env` y ajusta los valores.
# Las variables DEBEN empezar con VITE_ para estar disponibles
# en el navegador (Vite solo expone ese prefijo).
# ============================================================

# Nombre visible del panel
VITE_ADMIN_NAME="AD GLOBAL PERÚ"

# URL de la web pública (botón "Volver a la web")
VITE_PUBLIC_SITE_URL="https://adglobalperu.com"

# URL base versionada del backend. Se mantiene relativa para que el panel
# funcione igual en local (proxy de Vite) y en producción (mismo dominio).
VITE_API_URL="/api/v1"

# Intentos fallidos permitidos antes de bloquear el formulario de acceso.
VITE_AUTH_MAX_ATTEMPTS="5"
