# ============================================================
# AD GLOBAL - Panel Administrativo
# Config Apache / LiteSpeed para Webuzo
# Se copia automáticamente a la raíz de `dist/` al compilar.
# ============================================================

# ---------- Compresión GZIP ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml image/svg+xml
</IfModule>

# ---------- Caché de recursos estáticos ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|jpg|jpeg|png|webp|avif|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Seguridad básica
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Si la API vive en otro origen, añade su URL a connect-src.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https:; frame-src 'self' about:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  # El panel administrativo no debe indexarse en buscadores
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# ---------- Fallback SPA ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /panel_admin/

  # No reescribir archivos o directorios existentes
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo lo demás se sirve desde index.html
  RewriteRule ^ /panel_admin/index.html [L]
</IfModule>

# ---------- Página de error ----------
ErrorDocument 404 /panel_admin/index.html
