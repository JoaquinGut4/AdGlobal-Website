# ============================================================
# Variables de entorno del BACKEND (Fase 2)
# Copia este archivo como `.env` en la raíz del proyecto.
# NO subas el archivo `.env` real al repositorio.
# ============================================================

# --- Aplicación ---
APP_ENV=development
APP_PORT=8000
APP_URL="https://adglobalperu.com"

# --- Base de datos (MySQL / PostgreSQL) ---
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=adglobal
DB_USER=adglobal_user
DB_PASSWORD="cambia_esta_clave"

# Cadena completa alternativa (tiene prioridad si se define)
# DATABASE_URL="mysql+pymysql://usuario:clave@localhost:3306/adglobal"

# --- Seguridad / JWT (panel admin) ---
JWT_SECRET="genera_una_cadena_aleatoria_larga"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- CORS (dominios del frontend autorizados) ---
ALLOWED_ORIGINS="https://adglobalperu.com,http://localhost:3000"
